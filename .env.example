# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# S3-compatible Storage (AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=https://your-bucket.s3.region.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=college-resources

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=College Academic Hub

# Auth
AUTH_SECRET=your_auth_secret_generate_with_openssl_rand_base64_32

# Optional: Analytics, AI, etc.
# OPENAI_API_KEY=
# SENTRY_DSN=